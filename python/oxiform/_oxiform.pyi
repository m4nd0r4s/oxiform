from typing import Any, Generic, TypeVar, overload

_T = TypeVar("_T")

__version__: str

@overload
def json_decode(data: bytes | bytearray | memoryview | str) -> Any: ...
@overload
def json_decode(
    data: bytes | bytearray | memoryview | str, type: type[_T], *, max_errors: int = 100
) -> _T: ...
@overload
def json_decode(
    data: bytes | bytearray | memoryview | str, type: object, *, max_errors: int = 100
) -> Any: ...
def json_encode(obj: object, *, indent: int | None = None, sort_keys: bool = False) -> bytes: ...

class JsonEncoder:
    """A reusable JSON encoder with fixed options."""

    def __init__(self, *, indent: int | None = None, sort_keys: bool = False) -> None: ...
    def encode(self, obj: object) -> bytes: ...

class JsonDecoder(Generic[_T]):
    """A reusable JSON decoder for one type."""

    @overload
    def __new__(cls, type: type[_T], *, max_errors: int = 100) -> JsonDecoder[_T]: ...
    @overload
    def __new__(cls, type: object = ..., *, max_errors: int = 100) -> JsonDecoder[Any]: ...
    @property
    def type(self) -> object: ...
    def decode(self, data: bytes | bytearray | memoryview | str) -> _T: ...

class PlanHandle: ...
